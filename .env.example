# ==============================================================================
# WorldEd Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in the values.
# See docs/environment-setup.md for detailed instructions.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Database (Drizzle ORM)
# ------------------------------------------------------------------------------
# Use the Transaction Pooler (port 6543) for Next.js serverless environments.
# Format: postgres://[user]:[password]@[host]:[port]/[db]
# Find this in: Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# Supabase Auth
# ------------------------------------------------------------------------------
# Find these in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# ------------------------------------------------------------------------------
# Google Gemini AI (for Eddi chatbot)
# ------------------------------------------------------------------------------
# Get this from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# Public URL of the application — used for password reset redirect URLs
# Development: http://localhost:3000
# Production:  https://your-production-domain.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Environment mode — set to 'production' in deployment
# Controls: error message verbosity, test routes, logging
NODE_ENV="development"
